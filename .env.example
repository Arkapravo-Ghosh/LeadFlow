# Shared private credential for Next.js -> FastAPI. Use at least 16 characters.
# Generate a value with: openssl rand -hex 32
BACKEND_API_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-random-hex-password
APP_TIMEZONE=Asia/Kolkata
# Change if another app already uses 3000.
FRONTEND_PORT=3000

# Public frontend origin, including scheme. Set your domain here in production.
APP_URL=http://localhost:3000

# Fixed session lifetime; users sign in again after expiry (1–168 hours).
AUTH_SESSION_HOURS=12

# Registration attempts per source within 15 minutes (1–1000).
SIGNUP_RATE_LIMIT=20
